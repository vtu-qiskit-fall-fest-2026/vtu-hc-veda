# ============================================================
# Green Quanta — Supabase configuration
# ============================================================
# Copy this file to `.env` (real secrets go in .env, not git).
# The app reads these values on startup. Until they are filled in,
# the app runs in "demo" mode using local data.

# Your Supabase project URL, e.g. https://yourapp.supabase.co
SUPABASE_URL=

# The "anon"/"publishable" key (public, safe for client use).
SUPABASE_ANON_KEY=

# The "service_role"/"secret" key (server-only. NEVER expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# OPTIONAL: Postgres connection string. If set, the backend auto-creates the
# tables on startup. If left blank, run backend/schema (in db.py SCHEMA_SQL)
# in the Supabase SQL editor instead.
# Example: postgresql://postgres:YOUR_DB_PASSWORD@db.yourapp.supabase.co:5432/postgres
SUPABASE_DB_URL=

# OpenAI AI tutor (server-only, never expose). If set, each tutor question is
# sent to OpenAI and answered specifically for it. If blank, the tutor uses the
# built-in local answer engine (the app still works fully).
OPENAI_API_KEY=your_openai_api_key_he_re
